{
  "info": {
    "_postman_id": "cocos-challenge-local-api",
    "name": "Cocos Challenge API - Local",
    "description": "Invoca la API local (http://localhost:8080, variable de coleccion `baseUrl`) con los datos cargados por la migracion V2: usuarios 1-4 (solo el usuario 1 tiene movimientos), instrumentos 1-65 (ACCIONES) y 66 (ARS, MONEDA). Cada request incluye ejemplos de respuesta. Las ordenes modifican la base local; las respuestas guardadas son ilustrativas (ids y fechas varian).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
